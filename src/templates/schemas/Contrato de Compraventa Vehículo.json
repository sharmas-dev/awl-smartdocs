        },
        {
          "key": "buyerSpouseAddress",
          "label": "Dirección del cónyuge del comprador",
          "type": "text",
          "required": true,
          "condition": { "field": "buyerHasCommunityProperty", "equals": "Sí" },
          "example": "Calle Principal 456, Santiago"
        }
      ]
    },
    {
      "id": "vehicle",
      "label": "C. DATOS DEL VEHÍCULO",
      "variables": [
        {
          "key": "vehicleChasisNo",
          "label": "Número de chasis (como aparece en la Matrícula)",
          "type": "text",
          "required": true,
          "example": "3GNAXUEV0NL123456"
        },
        {
          "key": "certificateOfTitleNo",
          "label": "Número de Matrícula (Certificado de Título)",
          "type": "text",
          "required": true,
          "example": "01-0012345"
        },
        {
          "key": "certificateOfTitleIssueDate",
          "label": "Fecha de emisión de la Matrícula",
          "type": "date",
          "required": true,
          "example": "15 de enero de 2024"
        },
        {
          "key": "vehicleBrand",
          "label": "Marca del vehículo",
          "type": "text",
          "required": true,
          "example": "Toyota"
        },
        {
          "key": "vehicleModel",
          "label": "Modelo del vehículo (como en la Matrícula)",
          "type": "text",
          "required": true,
          "example": "Corolla 2023"
        },
        {
          "key": "vehicleMotorDescription",
          "label": "Motor o número de serie (como en la Matrícula)",
          "type": "text",
          "required": true,
          "example": "2ZR-FE 1234567"
        },
        {
          "key": "vehicleLicensePlate",
          "label": "Placa oficial del vehículo",
          "type": "text",
          "required": true,
          "example": "A123456"
        },
        {
          "key": "vehicleColor",
          "label": "Color del vehículo (como en la Matrícula)",
          "type": "text",
          "required": true,
          "example": "Blanco"
        }
      ]
    },
    {
      "id": "payment",
      "label": "D. PRECIO Y FORMA DE PAGO",
      "variables": [
        {
          "key": "totalAmountInWords",
          "label": "Monto total en letras",
          "type": "text",
          "required": true,
          "example": "Dos Cientos Mil Pesos Dominicanos con 00/100"
        },
        {
          "key": "totalAmountWithCurrency",
          "label": "Monto total con moneda (cifras)",
          "type": "text",
          "required": true,
          "example": "RD$200,000.00"
        },
        {
          "key": "paymentDatesList",
          "label": "Fecha(s) de pago",
          "type": "text",
          "required": true,
          "example": "15 de marzo de 2026"
        },
        {
          "key": "paymentMethod",
          "label": "Método de pago",
          "type": "dropdown",
          "required": true,
          "options": ["Transferencia bancaria", "Cheque"]
        },
        {
          "key": "accountNumber",
          "label": "Número de cuenta bancaria (solo transferencia)",
          "type": "text",
          "required": true,
          "condition": { "field": "paymentMethod", "equals": "Transferencia bancaria" },
          "example": "123-456789-0"
        },
        {
          "key": "bankName",
          "label": "Nombre del banco",
          "type": "text",
          "required": true,
          "example": "Banco Popular Dominicano"
        },
        {
          "key": "checkNumber",
          "label": "Número de cheque (solo cheque)",
          "type": "text",
          "required": true,
          "condition": { "field": "paymentMethod", "equals": "Cheque" },
          "example": "001234"
        },
        {
          "key": "paymentDate",
          "label": "Fecha del comprobante de pago",
          "type": "date",
          "required": true,
          "example": "15 de marzo de 2026"
        },
        {
          "key": "annexLabel",
          "label": "Etiqueta del anexo de soportes de pago",
          "type": "text",
          "required": true,
          "example": "Anexo A"
        }
      ]
    },
    {
      "id": "documents",
      "label": "E. DOCUMENTOS Y PLAZOS",
      "variables": [
        {
          "key": "registryOfficeJurisdiction",
          "label": "Jurisdicción de la Cámara de Comercio (solo si vendedor es empresa)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "Santo Domingo"
        },
        {
          "key": "authorizationIssueDate",
          "label": "Fecha de la Carta de Autorización corporativa al representante (solo si vendedor es empresa)",
          "type": "date",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "10 de marzo de 2026"
        },
        {
          "key": "invoiceNo",
          "label": "Número de factura de venta (solo si vendedor es empresa)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "001234"
        },
        {
          "key": "invoiceIssueDate",
          "label": "Fecha de emisión de la factura (solo si vendedor es empresa)",
          "type": "date",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "15 de marzo de 2026"
        },
        {
          "key": "invoiceNcf",
          "label": "Número de Comprobante Fiscal — NCF (solo si vendedor es empresa)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "B0100000123"
        },
        {
          "key": "filingDeadlineDaysLetters",
          "label": "Plazo para depositar documentos ante la DGII (en letras)",
          "type": "text",
          "required": true,
          "example": "treinta"
        },
        {
          "key": "filingDeadlineDaysNumbers",
          "label": "Plazo para depositar documentos ante la DGII (en números, días)",
          "type": "number",
          "required": true,
          "example": "30"
        }
      ]
    },
    {
      "id": "signing",
      "label": "F. FIRMA",
      "variables": [
        {
          "key": "signingCity",
          "label": "Ciudad de firma",
          "type": "text",
          "required": true,
          "example": "Santo Domingo de Guzmán"
        },
        {
          "key": "signingProvince",
          "label": "Provincia o estado",
          "type": "text",
          "required": true,
          "example": "Distrito Nacional"
        },
        {
          "key": "signingCountry",
          "label": "País de firma",
          "type": "text",
          "required": true,
          "example": "República Dominicana"
        },
        {
          "key": "signingDateLetters",
          "label": "Día de firma en letras",
          "type": "text",
          "required": true,
          "example": "veinticuatro"
        },
        {
          "key": "signingDateNumbers",
          "label": "Día de firma en números",
          "type": "number",
          "required": true,
          "example": "24"
        },
        {
          "key": "signingMonthLetters",
          "label": "Mes de firma en letras",
          "type": "text",
          "required": true,
          "example": "marzo"
        },
        {
          "key": "signingYearLetters",
          "label": "Año de firma en letras",
          "type": "text",
          "required": true,
          "example": "dos mil veintiséis"
        },
        {
          "key": "signingYearNumbers",
          "label": "Año de firma en números",
          "type": "number",
          "required": true,
          "example": "2026"
        }
      ]
    }
  ]
}
