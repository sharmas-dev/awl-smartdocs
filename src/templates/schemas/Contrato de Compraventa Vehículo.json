          "key": "buyerJurisdiction",
          "label": "País o estado de constitución (solo empresa)",
          "type": "text",
          "required": true,
          "condition": { "field": "buyerIsCompany", "equals": "Empresa" },
          "example": "República Dominicana"
        },
        {
          "key": "buyerCompanyOrigin",
          "label": "Origen de la sociedad (solo empresa)",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "buyerIsCompany", "equals": "Empresa" },
          "options": ["Nacional", "Extranjera"]
