{
  "templateName": "Contrato de Compraventa Vehículo",
  "displayName": "Contrato de Compraventa de Vehículo de Motor",
  "description": "Formulario para completar las variables del Contrato de Compraventa de Vehículo de Motor (vendedor, comprador, vehículo, precio, documentos y firma).",
  "groups": [
    {
      "id": "seller",
      "label": "A. EL VENDEDOR",
      "variables": [
        {
          "key": "sellerIsCompany",
          "label": "¿El vendedor es empresa o persona física?",
          "type": "dropdown",
          "required": true,
          "options": ["Empresa", "Persona física"]
        },
        {
          "key": "sellerTypeLabel",
          "label": "Tipo de vendedor (texto que aparece en el contrato; se asigna automáticamente cuando corresponde)",
          "type": "dropdown",
          "required": true,
          "options": ["la sociedad", "el señor", "la señora"]
        },
        {
          "key": "sellerGender",
          "label": "Género del vendedor (solo persona física)",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Persona física" },
          "options": ["Hombre", "Mujer"]
        },
        {
          "key": "sellerLegalName",
          "label": "Nombre completo del vendedor (nombre y apellidos, o razón social)",
          "type": "text",
          "required": true,
          "example": "Constructora ABC, S.A. / Juan Pérez Gómez"
        },
        {
          "key": "sellerJurisdiction",
          "label": "País o estado de constitución (solo empresa)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "República Dominicana"
        },
        {
          "key": "sellerCompanyOrigin",
          "label": "Origen de la sociedad (solo empresa)",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "options": ["Nacional", "Extranjera"]
        },
        {
          "key": "sellerHasDominicanRnc",
          "label": "¿La sociedad extranjera tiene RNC dominicano?",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "sellerCompanyOrigin", "equals": "Extranjera" },
          "options": ["Sí", "No"]
        },
        {
          "key": "sellerIncludeRncInContract",
          "label": "Incluir cláusula de RNC en el contrato (calculado)",
          "type": "dropdown",
          "required": false,
          "options": ["Sí", "No"]
        },
        {
          "key": "sellerRnc",
          "label": "RNC de la empresa vendedora (9 dígitos, formato XXX-XXXXX-X)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIncludeRncInContract", "equals": "Sí" },
          "example": "1-01-23456-7"
        },
        {
          "key": "sellerFullAddress",
          "label": "Dirección completa del vendedor",
          "type": "text",
          "required": true,
          "example": "Av. Churchill 123, Piantini, Santo Domingo"
        },
        {
          "key": "sellerRepTitle",
          "label": "Cargo del representante (opcional: Gerente, Presidente, Secretario)",
          "type": "text",
          "required": false,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "Presidente"
        },
        {
          "key": "sellerRepFullName",
          "label": "Nombre completo del representante (solo empresa)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "Carlos Rodríguez"
        },
        {
          "key": "sellerRepNationality",
          "label": "Nacionalidad del representante (solo empresa)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "dominicano"
        },
        {
          "key": "sellerRepIdType",
          "label": "Tipo de ID del representante (solo empresa)",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "options": ["de la cédula de identidad y electoral", "del pasaporte"]
        },
        {
          "key": "sellerRepIdNumber",
          "label": "Número de cédula o pasaporte del representante legal del vendedor (cédula de 11 dígitos o pasaporte)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "001-1234567-8"
        },
        {
          "key": "sellerRepFullAddress",
          "label": "Dirección del representante (solo empresa)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Empresa" },
          "example": "Santo Domingo, DN"
        },
        {
          "key": "sellerNationality",
          "label": "Nacionalidad del vendedor (solo persona física)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Persona física" },
          "example": "dominicano"
        },
        {
          "key": "sellerMaritalStatus",
          "label": "Estado civil del vendedor (solo persona física)",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Persona física" },
          "options": ["casado(a)", "soltero(a)"]
        },
        {
          "key": "sellerHasCommunityProperty",
          "label": "¿Casado bajo comunidad de bienes?",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "sellerMaritalStatus", "equals": "casado(a)" },
          "options": ["Sí", "No"]
        },
        {
          "key": "sellerIdType",
          "label": "Tipo de ID del vendedor (solo persona física)",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Persona física" },
          "options": ["de la cédula de identidad y electoral", "del pasaporte"]
        },
        {
          "key": "sellerIdNumber",
          "label": "Número de ID del vendedor (solo persona física)",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerIsCompany", "equals": "Persona física" },
          "example": "001-9876543-2"
        },
        {
          "key": "sellerSpouseFullName",
          "label": "Nombre completo del cónyuge del vendedor",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerHasCommunityProperty", "equals": "Sí" },
          "example": "María López"
        },
        {
          "key": "sellerSpouseNationality",
          "label": "Nacionalidad del cónyuge del vendedor",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerHasCommunityProperty", "equals": "Sí" },
          "example": "dominicana"
        },
        {
          "key": "sellerSpouseIdType",
          "label": "Tipo de ID del cónyuge del vendedor",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "sellerHasCommunityProperty", "equals": "Sí" },
          "options": ["de la cédula de identidad y electoral", "del pasaporte"]
        },
        {
          "key": "sellerSpouseIdNumber",
          "label": "Número de ID del cónyuge del vendedor",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerHasCommunityProperty", "equals": "Sí" },
          "example": "001-5555555-6"
        },
        {
          "key": "sellerSpouseAddress",
          "label": "Dirección del cónyuge del vendedor",
          "type": "text",
          "required": true,
          "condition": { "field": "sellerHasCommunityProperty", "equals": "Sí" },
          "example": "Av. Churchill 123, Piantini, Santo Domingo"
        }
      ]
    },
    {
      "id": "buyer",
      "label": "B. EL COMPRADOR",
      "variables": [
        {
          "key": "buyerIsCompany",
          "label": "¿El comprador es empresa o persona física?",
          "type": "dropdown",
          "required": true,
          "options": ["Empresa", "Persona física"]
        },
        {
          "key": "buyerTypeLabel",
          "label": "Tipo de comprador (texto que aparece en el contrato; se asigna automáticamente cuando corresponde)",
