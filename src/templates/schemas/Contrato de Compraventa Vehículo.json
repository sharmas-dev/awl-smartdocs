        },
        {
          "key": "buyerRepFullAddress",
          "label": "Dirección del representante (solo empresa)",
          "type": "text",
          "required": true,
          "condition": { "field": "buyerIsCompany", "equals": "Empresa" },
          "example": "Santiago, Santiago"
        },
        {
          "key": "buyerNationality",
          "label": "Nacionalidad del comprador (solo persona física)",
          "type": "text",
          "required": true,
          "condition": { "field": "buyerIsCompany", "equals": "Persona física" },
          "example": "dominicano"
        },
        {
