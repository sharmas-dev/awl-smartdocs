          "condition": { "field": "buyerHasCommunityProperty", "equals": "Sí" },
          "example": "dominicano"
        },
        {
          "key": "buyerSpouseIdType",
          "label": "Tipo de ID del cónyuge del comprador",
          "type": "dropdown",
