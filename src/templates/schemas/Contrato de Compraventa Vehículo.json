          "type": "text",
          "required": true,
          "condition": { "field": "buyerIsCompany", "equals": "Empresa" },
          "example": "dominicana"
        },
        {
          "key": "buyerRepIdType",
          "label": "Tipo de ID del representante (solo empresa)",
          "type": "dropdown",
          "required": true,
          "condition": { "field": "buyerIsCompany", "equals": "Empresa" },
          "options": ["de la cédula de identidad y electoral", "del pasaporte"]
        },
        {
